{
  "name": "@arslan-jh/dsh-deepseek-usage",
  "version": "1.0.1",
  "private": true,
  "description": "DeepSeek Harness web plugin showing account balance and an evidence-bounded estimate of today's CNY consumption",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js",
    "test": "node --test",
    "prepack": "npm run check && npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "deepseek",
    "deepseek-harness",
    "dsh-plugin",
    "plugin",
    "usage",
    "balance",
    "billing",
    "web"
  ],
  "author": "Arslan-jh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arslan-jh/dsh-deepseek-usage.git"
  },
  "homepage": "https://github.com/Arslan-jh/dsh-deepseek-usage#readme",
  "bugs": {
    "url": "https://github.com/Arslan-jh/dsh-deepseek-usage/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session-persistence": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-credentials": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-persistence": "0.1.0-rc.6"
  }
}
